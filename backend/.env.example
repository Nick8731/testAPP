APP_ENV=development
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# 預設使用 SQLite；啟動 API 時會自動建立資料庫與資料表。
DB_BACKEND=sqlite
SQLITE_PATH=data/smashcoach.db
# 快照僅在後台運行時自動建立；私人備份不要提交或公開。
SQLITE_BACKUP_ENABLED=true
SQLITE_BACKUP_INTERVAL_MINUTES=360
SQLITE_BACKUP_DIR=data/backups
# 若要改用 SQL Server，請將 DB_BACKEND 改為 sqlserver 並設定以下欄位。
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SmashCoach
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TRUSTED_CONNECTION=false
